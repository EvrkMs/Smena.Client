<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
		<Nullable>enable</Nullable>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>
		<EnableWindowsTargeting>true</EnableWindowsTargeting>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Google.Protobuf" Version="3.33.2" />
		<PackageReference Include="Grpc.Net.Client" Version="2.76.0" />
		<PackageReference Include="Grpc.Tools" Version="2.76.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.0" />
		<PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4022.49" />
	</ItemGroup>
	<ItemGroup>
		<Protobuf Include="Protos/*.proto" GrpcServices="Client">
			<AdditionalImportDirs>Protos</AdditionalImportDirs>
		</Protobuf>
	</ItemGroup>
	<ItemGroup>
		<None Update="appsettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<!--
		reactapp/ - это отдельный npm-проект внутри папки C#-проекта. SDK-style .csproj по
		умолчанию глобит ВСЁ под своей директорией как None-items, включая node_modules -
		без Remove ниже IDE/dotnet build будут пытаться проиндексировать/скопировать
		десятки тысяч файлов из node_modules.
	-->
	<ItemGroup>
		<Compile Remove="reactapp/**" />
		<Content Remove="reactapp/**" />
		<None Remove="reactapp/**" />
		<EmbeddedResource Remove="reactapp/**" />
	</ItemGroup>

	<!--
		Собирает reactapp (Vite) и копирует результат в $(OutDir)webui, откуда его
		грузит MainForm.cs через SetVirtualHostNameToFolderMapping. ItemGroup с
		ReactAppDist объявлен ВНУТРИ таргета намеренно: если вынести его на верхний
		уровень .csproj, MSBuild вычислит glob на этапе evaluation - до того, как
		npm run build успеет создать dist/, и файлы просто не попадут в сборку.
		Отключить локально: dotnet build -p:SkipReactAppBuild=true
	-->
	<Target Name="BuildAndCopyReactApp" AfterTargets="Build" Condition="'$(SkipReactAppBuild)' != 'true'">
		<Exec Command="npm ci" WorkingDirectory="reactapp" Condition="!Exists('reactapp/node_modules')" />
		<Exec Command="npm run build" WorkingDirectory="reactapp" />
		<ItemGroup>
			<ReactAppDist Include="reactapp/dist/**/*.*" />
		</ItemGroup>
		<Copy SourceFiles="@(ReactAppDist)" DestinationFolder="$(OutDir)webui\%(RecursiveDir)" SkipUnchangedFiles="true" />
	</Target>

</Project>
